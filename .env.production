# Production Environment Variables for Vercel Deployment
# Using Vercel proxy to avoid CORS issues
VITE_API_URL=https://jj-essencial.afribase.dev
VITE_APP_NAME=JJ Essential
VITE_APP_URL=https://essentialbyjay-nu.vercel.app
VITE_NODE_ENV=production

# Payment Gateway Keys (Public keys only)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key

# App Configuration
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=true

# File Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/jjessencial
VITE_TWITTER_URL=https://twitter.com/jjessencial
VITE_INSTAGRAM_URL=https://instagram.com/jjessencial
VITE_WHATSAPP_NUMBER=+2341234567890

# Contact Information
VITE_SUPPORT_EMAIL=support@jjessencial.com
VITE_CONTACT_PHONE=+2341234567890
VITE_BUSINESS_ADDRESS=123 Commerce Street, Lagos, Nigeria

# Feature Flags
VITE_ENABLE_TRADES=true
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_SUPPORT_CHAT=true
VITE_ENABLE_BANK_TRANSFER=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ADMIN=true